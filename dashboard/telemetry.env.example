# Claude Code telemetry -> local dashboard.
# Put these in your shell profile, OR (cleaner) in ~/.claude/settings.json under
# "env": { ... } so they apply only to Claude Code. Then restart Claude Code.
#
# settings.json form:
#   "env": {
#     "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
#     "OTEL_METRICS_EXPORTER": "otlp",
#     "OTEL_LOGS_EXPORTER": "otlp",
#     "OTEL_TRACES_EXPORTER": "otlp",
#     "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
#     "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
#     "OTEL_METRIC_EXPORT_INTERVAL": "10000",
#     "OTEL_METRICS_INCLUDE_SESSION_ID": "true",
#     "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "1",
#     "OTEL_LOG_TOOL_DETAILS": "1"
#   }

export CLAUDE_CODE_ENABLE_TELEMETRY=1
export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_TRACES_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Faster export so the dashboard feels live (default is 60s for metrics).
export OTEL_METRIC_EXPORT_INTERVAL=10000
export OTEL_LOGS_EXPORT_INTERVAL=5000

# Keep session.id as a metric label so you can drill by session in Grafana.
export OTEL_METRICS_INCLUDE_SESSION_ID=true
export OTEL_METRICS_INCLUDE_ACCOUNT_UUID=false

# Per-subagent / per-stage drill-down: emit spans (agent tree) to Tempo.
export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1

# Real agent/skill/plugin/MCP names on the token + cost metrics (v2.1.273+).
# Without it, user-defined agents collapse into agent_name="custom". Also puts
# tool arguments (bash commands, file paths) into log events — they stay in the
# local collector's log file (~/.claude/logs/otel/), but that file now holds them.
export OTEL_LOG_TOOL_DETAILS=1
