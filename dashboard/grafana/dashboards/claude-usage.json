{
  "title": "Claude Code — Usage & Cost",
  "uid": "claude-usage",
  "editable": true,
  "schemaVersion": 39,
  "timezone": "browser",
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "tags": ["claude-code", "cost"],
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(claude_code_token_usage_tokens_total, model)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(claude_code_token_usage_tokens_total, session_id)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "READ ME FIRST — verify your metric names",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "OTel→Prometheus renames metrics (dots→underscores, unit suffix, `_total` for counters). These panels assume **`claude_code_token_usage_tokens_total`**, **`claude_code_cost_usage_USD_total`**, **`claude_code_session_count_total`**. If panels are empty, open the collector's raw metrics at **http://localhost:8889/metrics** (or Grafana → Explore → Prometheus → Metrics browser) and swap in the exact names your version emits. Label names (`model`, `session_id`, `type`) may also differ — the Metrics browser shows the truth. For **which subagent/stage** burned tokens, use the **Tempo** datasource in Explore (enable `CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1` first) — each agent is a span."
      }
    },
    {
      "type": "stat",
      "title": "Tokens (range)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_token_usage_tokens_total{model=~\"$model\", session_id=~\"$session\"}[$__range]))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "stat",
      "title": "Est. cost USD (range)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_cost_usage_USD_total{model=~\"$model\", session_id=~\"$session\"}[$__range]))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 } }
    },
    {
      "type": "stat",
      "title": "Sessions (range)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_session_count_total[$__range]))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "stat",
      "title": "Output tokens (range)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(increase(claude_code_token_usage_tokens_total{type=\"output\", model=~\"$model\", session_id=~\"$session\"}[$__range]))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "timeseries",
      "title": "Token rate by model (tokens/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (model) (rate(claude_code_token_usage_tokens_total{model=~\"$model\", session_id=~\"$session\"}[$__rate_interval]))", "legendFormat": "{{model}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Token rate by type (input / output / cache)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (type) (rate(claude_code_token_usage_tokens_total{model=~\"$model\", session_id=~\"$session\"}[$__rate_interval]))", "legendFormat": "{{type}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cost rate by model (USD/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (model) (rate(claude_code_cost_usage_USD_total{model=~\"$model\", session_id=~\"$session\"}[$__rate_interval]))", "legendFormat": "{{model}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "type": "table",
      "title": "Tokens by session (drill-down)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sort_desc(sum by (session_id, model) (increase(claude_code_token_usage_tokens_total{model=~\"$model\", session_id=~\"$session\"}[$__range])))", "format": "table", "instant": true, "refId": "A" }
      ]
    }
  ]
}
